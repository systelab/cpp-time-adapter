def profile = "vs2022.conanprofile"
def archs = ['x86', 'x86_64']
def configs = ['Debug', 'Release']

library identifier: "cpp-jenkins-pipelines@master", retriever: modernSCM(
  [$class: "GitSCMSource",
   remote: "https://github.com/systelab/cpp-jenkins-pipelines.git",
   credentialsId: "GitHubCredentials"])
   
pipeline
{
	agent
	{
		label 'lib-build'
	}

	parameters
	{
		string(	name: 'version',
				description: 'Number of the version to build (must match the name of the tag that will be checked out)',
				defaultValue: '0.0.0' )
	}

	options
	{
		skipDefaultCheckout(true)
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '5'))
	}

	stages
	{
		stage('Checkout')
		{
			steps
			{
				deleteDir()
				checkoutSourceCodeFromTag(version)
			}
		}
		
		stage('Build')
		{	
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							stage("Build ${config}|${arch}")
							{
								def buildFolder = "build/${config}-${arch}"
								bat "conan install . --output-folder ${buildFolder} --profile:all=${profile} -s arch=${arch} -s build_type=${config}"
								bat "conan build . --output-folder ${buildFolder} --profile:all=${profile} -s arch=${arch} -s build_type=${config}" 
								bat "conan export-pkg . --name time-adapter --version ${params.version} --output-folder ${buildFolder} --profile:all=${profile} -s arch=${arch} -s build_type=${config} --force"
								bat "conan test ./test_package/conanfile.py time-adapter/${params.version} --profile:all=${profile} -s arch=${arch} -s build_type=${config}"
								dir("${buildFolder}/bin/${config}/")
								{
									bat "TimeAdapterTest.exe --gtest_output=xml:TimeAdapterTest.xml"
								}
								
								dir("test/TimeAdapterTestUtilities")
								{
									bat "conan install . --version ${params.version} --output-folder ${buildFolder} --profile:all=../../${profile} -s arch=${arch} -s build_type=${config}"
									bat "conan build . --version ${params.version} --output-folder ${buildFolder} --profile:all=../../${profile} -s arch=${arch} -s build_type=${config}"
									bat "conan export-pkg . --name time-adapter-test-utilities --version ${params.version} --output-folder ${buildFolder} --profile:all=../../${profile} -s arch=${arch} -s build_type=${config} --force"
									bat "conan test ./test_package/conanfile.py time-adapter-test-utilities/${params.version} --profile:all=../../${profile} -s arch=${arch} -s build_type=${config}"
								}
							}
						}
					}
				}
			}
		}

		stage('Deploy')
		{
			steps
			{
				script
				{
					bat "conan upload time-adapter/${params.version} -r aid-conan-production-local --force"
					bat "conan upload time-adapter-test-utilities/${params.version} -r aid-conan-production-local --force"
				}
			}
		}	
	}
	
	post
	{
		always
		{
			junit allowEmptyResults: true, testResults: "build*/TimeAdapterTest.xml"
			script
			{
				currentBuild.description = params.version
			}
		}
	}
}
