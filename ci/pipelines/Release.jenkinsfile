def profile = "vs2022.conanprofile"
def archs = ['x86', 'x86_64']
def configs = ['Debug', 'Release']

library identifier: "cpp-jenkins-pipelines@master", retriever: modernSCM(
  [$class: "GitSCMSource",
   remote: "https://github.com/systelab/cpp-jenkins-pipelines.git",
   credentialsId: "GitHubCredentials"])
   
pipeline
{
	agent
	{
		label 'lib-build'
	}

	parameters
	{
		string(	name: 'version',
				description: 'Number of the version to build (must match the name of the tag that will be checked out)',
				defaultValue: '0.0.0' )
	}

	options
	{
		skipDefaultCheckout(true)
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '5'))
	}

	environment
	{
		PATH = "${env.USERPROFILE}\\.venvs\\conan2\\Scripts;${env.PATH}"
	}

	stages
	{
		stage('Checkout')
		{
			steps
			{
				deleteDir()
				checkoutSourceCodeFromTag(params.version)
			}
		}
		
		stage('Build')
		{	
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							stage("Build ${config}|${arch}")
							{
								bat "conan create . --name time-adapter --version ${params.version} --profile:all=${profile} -s arch=${arch} -s build_type=${config} -tf=\"\""
								
								dir("test/TimeAdapterTestUtilities")
								{
									bat "conan create . --name time-adapter-test-utilities --version ${params.version} --profile:all=../../${profile} -s arch=${arch} -s build_type=${config} -tf=\"\""
								}
							}
						}
					}
				}
			}
		}

		stage('Test packages')
		{
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							stage("Test ${config}|${arch}")
							{
								bat "conan test test_package time-adapter/${params.version} --profile:all=${profile} -s arch=${arch} -s build_type=${config}"
								dir("test/TimeAdapterTestUtilities")
								{
									bat "conan test test_package time-adapter-test-utilities/${params.version} --profile:all=../../${profile} -s arch=${arch} -s build_type=${config}"
								}
							}
						}
					}
				}
			}
		}

		stage('Deploy')
		{
			steps
			{
				script
				{
					bat "conan upload time-adapter/${params.version} -r aid-conan-production-local --confirm --force"
					bat "conan upload time-adapter-test-utilities/${params.version} -r aid-conan-production-local --confirm --force"
				}
			}
		}	
	}
	
	post
	{
		always
		{
			junit allowEmptyResults: true, testResults: "build/**/TimeAdapterTest.xml"
			script
			{
				currentBuild.description = params.version
			}
		}
	}
}
